# Copy this file to .env.local for local development.
# Find both values in Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only. Never prefix this value with NEXT_PUBLIC_ or commit the real key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Random secret sent by Vercel Cron in: Authorization: Bearer <value>
CRON_SECRET=GENERATE_A_LONG_RANDOM_VALUE
