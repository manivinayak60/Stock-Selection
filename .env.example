# Copy this file to .env.local for local development.
# Find both values in Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only. Never prefix this value with NEXT_PUBLIC_ or commit the real key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Random secret sent by Vercel Cron in: Authorization: Bearer <value>
CRON_SECRET=GENERATE_A_LONG_RANDOM_VALUE

# Optional but strongly recommended for this private app. Find it in
# Supabase Dashboard -> Authentication -> Users -> your user UUID.
APP_OWNER_USER_ID=YOUR_SUPABASE_USER_UUID

# Server-only broker credentials. Use a different random value from CRON_SECRET.
BROKER_TOKEN_ENCRYPTION_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
KITE_API_KEY=
KITE_API_SECRET=
# Optional HTTPS URL to a licensed CSV matching data/fundamentals-template.csv.
FUNDAMENTALS_CSV_URL=

# Local backfill depth. 756 sessions is approximately three trading years.
BACKFILL_SESSIONS=756
